SECRET_KEY=replace-with-a-long-unique-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Omit for local SQLite; set for PostgreSQL.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
CORS_ALLOWED_ORIGINS=http://localhost:5173
CLOUDINARY_URL=
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
# Website origin used in password-reset links.
FRONTEND_URL=http://localhost:5173
# Production email (SMTP). Development prints emails to the console instead.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=BRIGHTHOMES <no-reply@example.com>
